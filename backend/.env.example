# Copy to .env for local dev. Docker sets these via docker-compose.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use a local SQLite file (fast dev/tests).
# In Docker this points at the postgres service.
# DATABASE_URL=postgres://nava:nava@db:5432/nava

# Frontend origin(s) allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment gateway: "zarinpal" (real sandbox, the default) or "fake" (offline).
#
# The ZarinPal sandbox needs no merchant account — any well-formed UUID is
# accepted as a merchant id. It does go over the network, though, so if it is
# unreachable when you need to demo, switch to the fake gateway:
#     PAYMENT_GATEWAY=fake
# The fake gateway runs the identical checkout → redirect → verify flow without
# leaving the machine. It never grants a subscription that was not "paid for":
# an authority containing "fail" verifies as a failed payment.
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=b8f1e2c4-3a67-4d5b-9c81-2f4e6a0d7b39
ZARINPAL_SANDBOX=True
# Where the gateway sends the user back after payment (frontend route).
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback
