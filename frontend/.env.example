# Copy to .env.local before running `npm run dev`:
#
#   cp .env.example .env.local
#
# This is the URL the *browser* calls, so it must be reachable from the browser
# — not from inside a container. It is read at build time, so restart the dev
# server after changing it.
#
# 8001 matches the port in the project README. Docker Compose uses 8000 and
# passes its own value in, so this file does not affect `docker compose up`.
NEXT_PUBLIC_API_URL=http://localhost:8001/api
